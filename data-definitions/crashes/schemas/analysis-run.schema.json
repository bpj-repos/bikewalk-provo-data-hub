{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provostreets.watch/schemas/danger-zones/analysis-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisRunId",
    "analysisType",
    "analysisVersion",
    "createdAt",
    "sourceArtifacts",
    "parameters",
    "resultCounts",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisRunId": { "type": "string", "minLength": 12 },
    "analysisType": { "type": "string", "minLength": 1 },
    "analysisVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKey", "snapshotId", "path", "sha256"],
        "properties": {
          "sourceKey": { "type": "string" },
          "snapshotId": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "parameters": { "type": "object" },
    "resultCounts": { "type": "object" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rows", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "rows": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
