{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provostreets.watch/schemas/danger-zones/source-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "steward",
          "officialUrl",
          "accessClass",
          "accessStatus",
          "evidenceFamily",
          "format",
          "expectedCadence",
          "importer",
          "schemaVersion",
          "geography",
          "dependencies",
          "limitations"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "steward": { "type": "string", "minLength": 1 },
          "officialUrl": { "type": ["string", "null"], "format": "uri" },
          "accessClass": {
            "enum": ["public", "public-derived-only", "restricted", "internal-sensitive"]
          },
          "accessStatus": { "type": "string", "minLength": 1 },
          "evidenceFamily": {
            "enum": [
              "observed",
              "measured",
              "modeled",
              "estimated-exposure",
              "official-reconciliation",
              "community",
              "context"
            ]
          },
          "format": { "type": "string", "minLength": 1 },
          "expectedCadence": { "type": "string", "minLength": 1 },
          "importer": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "geography": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
