{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provostreets.watch/schemas/danger-zones/snapshot-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "sourceKey",
    "retrievedAt",
    "retrievalCompletedAt",
    "sourceCurrentThrough",
    "accessClass",
    "sourceCrs",
    "recordCount",
    "schemaFingerprint",
    "geographicExtent",
    "files",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "minLength": 12 },
    "sourceKey": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "retrievalCompletedAt": { "type": "string", "format": "date-time" },
    "sourceCurrentThrough": { "type": ["string", "null"], "format": "date-time" },
    "accessClass": {
      "enum": ["public", "public-derived-only", "restricted", "internal-sensitive"]
    },
    "sourceCrs": { "type": ["string", "null"] },
    "recordCount": { "type": "integer", "minimum": 0 },
    "schemaFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "geographicExtent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
